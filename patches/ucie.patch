diff --git a/scala/resources/vsrc/clocking_tile.v b/scala/resources/vsrc/clocking_tile.v
index d3345f9..d7837cc 100644
--- a/scala/resources/vsrc/clocking_tile.v
+++ b/scala/resources/vsrc/clocking_tile.v
@@ -13,8 +13,26 @@ module clocking_tile(
   assign DigitalClk = DigBypassClk;
 
   assign TxClk = BypassClk;
-  // TxClkQ is the quadrature (90 degree) phase of TxClk. A true quarter-cycle
-  // shift cannot be expressed combinationally, so this stub uses the inverted
-  // clock: edge count and frequency are right, phase relationship is not.
-  assign TxClkQ = ~BypassClk;
+
+  // TxClkQ is the quadrature (90 degree) phase of TxClk in the real tile, and
+  // ucie_clk_dist_network drives the TXCLKP/TXCLKN lanes from it so the
+  // forwarded clock leaves the die centre-aligned to the data eye. A quarter
+  // cycle cannot be expressed combinationally, so this stub has to approximate.
+  //
+  // It previously used `~BypassClk`. That is 180 degrees, not 90: the clock
+  // lanes come out a whole UI away from the data and track lanes rather than
+  // half a UI, and the tile's own comment noted the phase relationship was not
+  // modelled. Against a partner whose mainband model is quantised to whole UI,
+  // that whole-UI skew is not a rounding difference, it is a wrong bit. It made
+  // MBINIT.REPAIRCLK unpassable: the partner samples the clock and track lanes
+  // into one chunk at the same UI indices and compares both against the same
+  // reference, so it read ckp = 0xaaaa where trk = 0x5555 and its
+  // consecutive-match run never rose above 1 of the 48 it needs.
+  //
+  // Aligning TxClkQ with TxClk is the honest approximation for a UI-quantised
+  // simulation: zero skew is representable and half a UI is not, so this keeps
+  // the clock lanes on the UI they belong to. Sub-UI phase belongs to the
+  // analog models (verilog/tx.vams), which is where the real quarter-cycle
+  // shift is resolved; nothing about this file's timing survives into silicon.
+  assign TxClkQ = BypassClk;
 endmodule
diff --git a/scala/resources/vsrc/ucie_clk_dist_network.sv b/scala/resources/vsrc/ucie_clk_dist_network.sv
index 4cfd225..237fdba 100644
--- a/scala/resources/vsrc/ucie_clk_dist_network.sv
+++ b/scala/resources/vsrc/ucie_clk_dist_network.sv
@@ -25,9 +25,34 @@ module ucie_clk_dist_network(
     endgenerate
 
     assign rxClkDivClk = rxClk;
+
+    // The receive lane clock, and an opt-in half-period shift for partners
+    // whose forwarded mainband clock is edge-aligned rather than centred.
+    //
+    // Sampling on the received clock's own edges is correct against a
+    // spec-compliant transmitter, because that transmitter sends its clock
+    // through the quadrature phase (see TXCLKP_LANE above) so its edges arrive
+    // in the middle of the data eye. That is the default and is unchanged.
+    //
+    // A partner modelled at UI granularity cannot centre its clock: it has no
+    // sub-UI phase to place it at, so it drives the clock lane and the data
+    // lanes on the same UI. Sampling such a clock on its own edges lands on
+    // the data transition instead of the eye, and the deserialized word comes
+    // out one UI shifted -- measured as 0x4aaaaaaa on the track lane where
+    // 0x55555555 was sent, which makes MBINIT.REPAIRCLK's pattern comparison
+    // fail on every lane. Inverting the lane clock moves the sample by half a
+    // clock period, which at two UI per clock is exactly the one UI needed.
+    //
+    // This is deliberately behind a define so the default behaviour stays
+    // correct for a compliant partner; only a co-simulation against a
+    // UI-quantised model should enable it.
     generate
         for (genvar i = 0; i < 18; i++) begin
+`ifdef UCIE_RX_SAMPLE_SHIFT_UI
+            assign rxLaneClk[i] = ~rxClk;
+`else
             assign rxLaneClk[i] = rxClk;
+`endif
         end
     endgenerate
 endmodule
